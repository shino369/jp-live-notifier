{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "chrome", "vitest/globals"]
  },
  "include": [
    "extension/**/*.js",
    "test/**/*.js",
    "e2e/**/*.js",
    "scripts/**/*.mjs",
    "*.config.js"
  ],
  "exclude": ["node_modules", "tmp", "test/fixtures"]
}
