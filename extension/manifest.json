{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "default_locale": "en",
  "version": "0.1.2",
  "description": "__MSG_appDescription__",
  "minimum_chrome_version": "130",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "src/ui/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "src/ui/options.html",
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "idle",
    "notifications",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://eplus.jp/*",
    "https://l-tike.com/*",
    "https://t.pia.jp/*",
    "https://ticket.rakuten.co.jp/*",
    "https://livepocket.jp/*",
    "https://asobi-ticket.api.app.t-riple.com/*",
    "https://www.zan-live.com/*",
    "https://zaiko.io/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:"
  }
}
